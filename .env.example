# Configuration for second-brain-builder.
#
# Copy this file to .env and uncomment the lines you want to change.
# Docker Compose reads .env. For a local run: uv run --env-file .env ...
# Never commit .env. An empty value counts as unset.

# Directory for the database (sbb.sqlite), the search index (search.sqlite),
# the generated secret.key, and staged uploads.
# SBB_DATA_DIR=/data

# Directory for the Brain clones, one per Brain: <dir>/<brain-id>/.
# SBB_BRAINS_DIR=/brains

# Model cache for Docling and Whisper. HF_HOME points here.
# SBB_MODELS_DIR=/models

# Fernet key that encrypts stored credentials. If unset, the app generates one
# in <SBB_DATA_DIR>/secret.key. To make a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SBB_SECRET_KEY=<fernet-key>

# Password for the web UI. If unset, the UI needs no login.
# SBB_PASSWORD=<password>

# Comma-separated Host header allowlist. Requests with another Host get HTTP 400.
# SBB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Base URL of this app, shown in the agent setup screen.
# SBB_PUBLIC_URL=http://localhost:8484

# GitHub App client id for the device flow.
# SBB_GITHUB_CLIENT_ID=<github-app-client-id>

# GitHub App slug, used to build the App install URL.
# SBB_GITHUB_APP_SLUG=<github-app-slug>

# Git LFS usage in bytes above which an upload needs confirmation (default 10 GiB).
# SBB_LFS_QUOTA_BYTES=10737418240

# Size limit in bytes for one upload (default 2 GiB).
# SBB_MAX_UPLOAD_BYTES=2147483648

# LLM token budget for the Ingest of one Source.
# SBB_INGEST_MAX_TOKENS=400000

# Number of jobs that the worker runs in parallel.
# SBB_WORKER_CONCURRENCY=1

# Target size of one resumable Ingest Part, in tokens.
SBB_INGEST_PART_TOKENS=16000

# Map-reduce Ingest
SBB_INGEST_MAP_REDUCE_MIN_PARTS=20
SBB_INGEST_MAP_CONCURRENCY=4
SBB_INGEST_MIN_FACTS_PER_PAGE=2
SBB_INGEST_REDUCE_CONCURRENCY=4
